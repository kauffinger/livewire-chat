{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kauffinger/livewire-chat-kit",
    "type": "project",
    "description": "A clean streamed chat kit for Laravel Livewire. Built with FluxUI & the Laravel AI SDK.",
    "keywords": [
        "laravel",
        "livewire",
        "llms",
        "ai-sdk",
        "fluxui",
        "chat"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/ai": "^1.3",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "livewire/flux": "^2.21",
        "livewire/livewire": "^4.4"
    },
    "require-dev": {
        "calebdw/larastan-livewire": "^2.6",
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.14",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.69",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-browser": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "format": [
            "vendor/bin/rector",
            "vendor/bin/pint",
            "npm run format"
        ],
        "format:check": [
            "vendor/bin/pint --test",
            "npm run format:check"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "cooldown": {
                "period": "7 days"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
